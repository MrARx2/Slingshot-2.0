      Throttle: 0
      Strafe: 0
      Yaw: 0
      Pitch: 0
      Lift: 0
      Downforce: 0
      StabilizationEnabled: 1
      GripBreaker: 0
  - label: Acceleration
    durationSeconds: 30
    resetCraftsBeforeSegment: 1
    initialForwardSpeedKmh: 0
    command:
      Throttle: 1
      Strafe: 0
      Yaw: 0
      Pitch: 0
      Lift: 0
      Downforce: 0
      StabilizationEnabled: 1
      GripBreaker: 0
  - label: Brake From 500
    durationSeconds: 8
