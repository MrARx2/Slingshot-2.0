  m_Name: V2_V3_Parity_Command_Profile
  m_EditorClassIdentifier: Lunarlight.Hovercraft.V3::Lunarlight.Hovercraft.V3.V3ParityCommandProfile
  segments:
  - label: Settle
    durationSeconds: 5
    resetCraftsBeforeSegment: 1
    initialForwardSpeedKmh: 0
    command:
      Throttle: 0
      Strafe: 0
      Yaw: 0
      Pitch: 0
      Lift: 0
      Downforce: 0
      StabilizationEnabled: 1
      GripBreaker: 0
  - label: Idle Hover
    durationSeconds: 20
